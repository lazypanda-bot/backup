APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# `log` records emails locally for development. Railway Trial requires an HTTPS email API.
MAIL_MAILER=log
# For Resend on Railway Free/Trial/Hobby, use MAIL_MAILER=resend and a sender on a verified domain.
RESEND_API_KEY=
# Gmail API uses HTTPS and requires OAuth credentials with the gmail.send scope.
# Set MAIL_MAILER=gmail-api and use a sender address belonging to the authorized Google account.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REFRESH_TOKEN=
# SMTP settings are for hosting platforms that permit outbound SMTP.
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_EMAIL=
COMPANY_NAME="LJS Realty and Brokerage"
COMPANY_PHONE="+63 921 345 6789"
COMPANY_EMAIL="ljsrealty@gmail.com"
COMPANY_ADDRESS="Unit 6 Labangon Town Center, Katipunan St, Cebu City, Philippines, 6000"
COMPANY_CITY="Cebu City, Philippines"
COMPANY_FACEBOOK_URL="https://www.facebook.com/LJSRealtyAndBrokerage"
COMPANY_MESSENGER_URL=
COMPANY_INSTAGRAM_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
